# Copy to backend/.env (gitignored) ONLY if you want the live-LLM path.
# Everything works WITHOUT a key (rule-based parser + templates are default).
# For Gemini (free tier) via its OpenAI-compatible endpoint:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_S=15
